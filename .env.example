# Copy to .env and fill in. This file stays on your computer (git-ignored).
SUPABASE_URL=            # Project URL, e.g. https://abcd1234.supabase.co
SUPABASE_PUBLISHABLE_KEY=  # the "publishable" (formerly "anon") key from Project Settings > API
SUPABASE_DB_URL=         # Postgres connection string (dashboard > Connect). Used locally only, to apply migrations
